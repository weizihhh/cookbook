{
  "name": "cookbook",
  "private": true,
  "version": "0.26.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sw-cache.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test -c playwright.pwa.config.js",
    "test": "npm run verify && npm run test:unit && npm run test:e2e && npm run test:e2e:pwa"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "vant": "^4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^26.1.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
